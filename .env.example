# ResolveFlow Environment Configuration

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_in_production_jwt_secret_key_australia

# LLM Providers (Mock Mode enabled by default if keys are empty)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_MODEL=gpt-4o

# Database & State Persistence (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resolveflow
CHECKPOINT_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resolveflow_checkpoints

# Slack Integration (Human-in-the-Loop)
SLACK_BOT_TOKEN=xoxb-mock-token-for-dev
SLACK_SIGNING_SECRET=mock-signing-secret
SLACK_OPS_CHANNEL=C0123456789
SLACK_MOCK_MODE=true

# Financial Rails & Postal Logistics
STRIPE_API_KEY=sk_test_mock_stripe_key_resolveflow
AUSPOST_API_KEY=mock_auspost_api_key_sydney
DISPUTE_AUTO_REFUND_THRESHOLD_AUD=100.00

# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
